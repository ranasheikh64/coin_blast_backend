PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster0.ek5om6i.mongodb.net/coinblast?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# ZEBEDEE (ZBD) Bitcoin Lightning Payout API Key
ZEBEDEE_API_KEY=

# Economy & Anti-Cheat Settings
CASHOUT_COOLDOWN_DAYS=7
POINTS_PER_SATOSHI=100
MINIMUM_CASHOUT_POINTS=1000
MIN_ADS_FOR_CASHOUT=3
AD_COINS_REWARD=300
MAX_DAILY_GAME_POINTS=15000
REQUIRE_GAME_SIGNATURE=true

# Set to 'false' in production so ONLY real Google AdMob SSV & ZBD payouts work
ALLOW_TEST_AD_REWARDS=false
ALLOW_SIMULATED_CASHOUT=false
